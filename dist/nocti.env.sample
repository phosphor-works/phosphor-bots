#
# Nocti's settings (docs/NOCTI.md): ~/.config/nocti/nocti.env, mode 600.
# Separate a list with commas.

# The Discord bot's token (Developer Portal, Bot, Reset Token). Needed.
NOCTI_TOKEN=

# The owner's Discord user id: who approves each draft. Needed.
NOCTI_OWNER=

# Who starts trusted, until /nocti untrust.
#NOCTI_TRUSTED=

# The channels it reads and posts in (none: every channel it sees).
#NOCTI_CHANNELS=

# Direct posts within the rules (0: every post is a draft), and the interval
# of the ones that take one, in minutes.
#NOCTI_DIRECT=1
#NOCTI_DIRECT_MINUTES=30

# Hours before a stranger who calls Nocti is greeted again, and greetings an
# hour at most, everyone together (0: none).
#NOCTI_GREET_HOURS=24
#NOCTI_GREET_PER_HOUR=10
