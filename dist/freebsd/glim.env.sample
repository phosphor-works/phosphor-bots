#
# Glim's settings (docs/GLIM.md). This file is root's, mode 600: it holds the
# Discord token. The GitHub App's key is a file of its own. The service reads
# it as shell: separate a list with commas, with no spaces.

# The Discord bot's token (Developer Portal, Bot, Reset Token). Needed.
GLIM_TOKEN=

# The GitHub App: its App ID (its settings page, About) and its private key,
# a file the user glim reads (mode 400). Needed.
GLIM_APP_ID=
GLIM_APP_KEY=/usr/local/etc/glim/app.pem

# The forums whose posts it files (the help forum's channel id). Needed.
GLIM_FORUMS=

# A forum tag's name to its repository, and short names for a mention.
GLIM_TAG_REPOS=plasmazones=PlasmaZones,afterglow=Afterglow,lambent=Lambent,phosphor=Phosphor
GLIM_ALIASES=pz=PlasmaZones,ag=Afterglow

# The roles that may file any post (Maintainer, Moderator, Contributor),
# beside the post's author.
#GLIM_STAFF_ROLES=

# Where attachments are kept for the issues, and the address that serves
# that folder (empty: attachments are only named in the issue).
#GLIM_FILES_DIR=/var/db/glim-files
#GLIM_FILES_URL=https://issues.example.org

# The staff API, behind Cloudflare Access (its team and its application's AUD
# tag), and the emails that may act (none: whom Access lets in).
#GLIM_STAFF_LISTEN=10.17.0.7:8090
#GLIM_ACCESS_TEAM=
#GLIM_ACCESS_AUD=
#GLIM_STAFF_EMAILS=

# The labels of a new issue (they must exist in each repository).
#GLIM_LABELS=
