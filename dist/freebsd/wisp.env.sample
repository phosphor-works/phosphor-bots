#
# Wisp's settings (docs/WISP.md). This file is root's, mode 600: it holds the
# tokens. An empty line or a commented one is no setting.

# The Discord bot's token (Developer Portal, Bot, Reset Token). Needed.
WISP_TOKEN=

# A fine-grained GitHub token, public repositories read-only. The cards and
# the feed need it.
#GITHUB_TOKEN=

# Short names someone may write before #123.
#WISP_ALIASES=pz=PlasmaZones ag=Afterglow pl=phosphor-libs psl=phosphor-shell-libs

# The repository of a bare #123, in every channel or in some.
#WISP_DEFAULT_REPO=Afterglow
#WISP_CHANNEL_REPOS=CHANNEL_ID=PlasmaZones

# The channels it replies in (none: every channel it can read).
#WISP_CHANNELS=

# The cards' channels, and the feed's (pushes to main, releases).
#WISP_CARDS_PRS=
#WISP_CARDS_ISSUES=
#WISP_FEED=
